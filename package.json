{
  "name": "domdomdom",
  "version": "0.2.1",
  "description": "DOM-aware JS evaluator. Pipe code via stdin to run against any HTML page (URL, local file, or inline). Lightweight happy-dom alternative to Playwright for non-layout, non-interactive tasks.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "domdomdom": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "quality": "tsc --noEmit && bun test",
    "build": "bun scripts/build.mjs",
    "smoke:node": "bun scripts/smoke-node.mjs",
    "smoke:pack": "bun scripts/smoke-pack.mjs",
    "version": "bun scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run quality && bun run smoke:node && bun run smoke:pack"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "license": "MIT",
  "author": "scruffymongrel",
  "homepage": "https://github.com/scruffymongrel/domdomdom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scruffymongrel/domdomdom.git"
  },
  "bugs": {
    "url": "https://github.com/scruffymongrel/domdomdom/issues"
  },
  "keywords": [
    "dom",
    "happy-dom",
    "html",
    "evaluation",
    "scraping",
    "testing",
    "cli",
    "claude-code",
    "agent-skill",
    "xpath",
    "document-evaluate",
    "htmx"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "happy-dom": "^20.9.0",
    "wicked-good-xpath": "^1.3.0"
  }
}
